PYTHONPATH=.

#============================
# LLM Provider Settings
#============================
# CoffeeAGNTCY uses litellm to manage LLM connections.
# Full list of supported providers:https://docs.litellm.ai/docs/providers
# Note: In CoffeeAGNTCY, the environment variable for specifying the model is always LLM_MODEL, regardless of the provider.
# Examples:

# OpenAI
# LLM_MODEL="openai/<model_of_choice>"
# OPENAI_API_KEY=<your_openai_api_key>

# Azure OpenAI
# LLM_MODEL="azure/<your_deployment_name>"
# AZURE_API_BASE=https://your-azure-resource.openai.azure.com/
# AZURE_API_KEY=<your_azure_api_key>
# AZURE_API_VERSION=<your_azure_api_version>

# GROQ
# LLM_MODEL="groq/<model_of_choice>"
# GROQ_API_KEY=<your_groq_api_key>

# Litellm Proxy
# LLM_MODEL="azure/<your_deployment_name>"
# LITELLM_PROXY_BASE_URL=<your_litellm_proxy_base_url>
# LITELLM_PROXY_API_KEY=<your_litellm_proxy_api_key>

# NVIDIA NIM
# LLM_MODEL="nvidia_nim/<model_of_choice>"
# NVIDIA_NIM_API_KEY=<your_nvidia_api_key>
# NVIDIA_NIM_API_BASE=<your_nvidia_nim_endpoint_url>

# Recommended temperature setting for OpenAI models
OPENAI_TEMPERATURE=0.7

#============================
# Local Development Settings
#============================
#(not needed when running agents via Docker Compose)

# OTEL environment variables
# OTLP_HTTP_ENDPOINT="http://localhost:4318"

# === Transport Settings ===
# SLIM (Default):
DEFAULT_MESSAGE_TRANSPORT=SLIM
# TRANSPORT_SERVER_ENDPOINT=http://localhost:46357
SLIM_SERVER=slim:46357
NATS_SERVER=nats:4222

# The SLIM peers (farm and exchange) use this secret to authenticate each other; the SLIM
# server itself does not check it. Set your own random value of at least 32 characters, the
# same for every peer.
# SLIM_SHARED_SECRET="<random-string-of-at-least-32-characters>"

# Local development only. If SLIM_SHARED_SECRET is unset, empty or the app-sdk placeholder,
# the farm refuses to start its SLIM interface unless this is true; with it the farm uses the
# public placeholder and logs a warning. docker-compose defaults it to true; leave it false
# (the code default) anywhere that is not a throwaway setup.
SLIM_ALLOW_PLACEHOLDER_SECRET=true

# Deadline in seconds for a single SLIM request/reply exchange. Defaults to 20, which
# covers an LLM-backed farm response; raise it for slower models or loaded providers.
# SLIM_REQUEST_TIMEOUT_SECONDS=20

# Alternative: NATS transport (uncomment to use NATS). The endpoint address must be in the form: nats://host:port.
# DEFAULT_MESSAGE_TRANSPORT=NATS
# TRANSPORT_SERVER_ENDPOINT=nats://localhost:4222

# === APIs (CORS) ===
# Comma-separated browser origins allowed to call the exchange API with credentials (scheme + host + port).
# Use the origin shown in the address bar for the Corto UI, not the API base URL. When unset or empty,
# defaults are http://localhost:3000 and http://127.0.0.1:3000 (local Vite UI).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
