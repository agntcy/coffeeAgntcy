{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.1"
  },
  "scripts": {
    "check": "npm run lint:check && npm run format:check && npm run typecheck && npm run test",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api-types": "openapi-typescript ../schema/openapi/openapi.yaml -o src/api/generated/agenticWorkflows.openapi.ts",
    "check:api-types": "npm run generate:api-types && git diff --exit-code -- src/api/generated/agenticWorkflows.openapi.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/system": "7.3.11",
    "@open-ui-kit/core": "3.1.0",
    "@xyflow/react": "12.10.0",
    "dompurify": "3.4.15",
    "mermaid": "11.16.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "6.1.2",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.11.1",
    "react-router-dom": "7.18.2",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "uuid": "11.1.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/dompurify": "3.0.5",
    "@types/node": "24.11.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.10.1",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "form-data": "4.0.6",
    "undici": "7.29.0",
    "brace-expansion": "5.0.9",
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "@eslint/config-array": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "@eslint/eslintrc": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
