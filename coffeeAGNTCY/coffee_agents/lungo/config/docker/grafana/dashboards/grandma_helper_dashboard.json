          "queryType": "table",
          "refId": "A",
          "rawSql": "SELECT ServiceName AS agent, round(Duration / 1e9, 2) AS seconds, SpanAttributes['helper.output'] AS answer FROM \"default\".\"otel_traces\" WHERE Timestamp >= $__fromTime AND Timestamp <= $__toTime AND TraceId = '${trace_id}' AND SpanName LIKE '%.handle' ORDER BY Timestamp"
