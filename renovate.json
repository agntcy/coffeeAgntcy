{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)"
  ],
  "configMigration": true,
  "enabled": true,
  "minimumReleaseAge": "14 days",
  "schedule": [
    "before 8am on Monday"
  ],
  "prCreation": "not-pending",
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "gomod",
    "helmv3",
    "npm",
    "pep621"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Track the tool versions pinned in scripts/lib/versions.sh (see scripts/setup.sh), via a `# renovate: datasource=... depName=...` comment above each *_VERSION line."
      ],
      "managerFilePatterns": [
        "/^scripts/lib/versions\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Z_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchCategories": [
        "golang"
      ],
      "description": [
        "Add go label to PRs which bumps go dependencies."
      ]
    },
    {
      "groupName": "Go patches",
      "groupSlug": "go-patches",
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "description": [
        "Group Go dependency patch updates in single PR."
      ]
    },
    {
      "groupName": "Github Actions",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "description": [
        "Group CI dependency updates in single PR."
      ]
    },
    {
      "groupName": "Docker",
      "groupSlug": "docker",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "description": [
        "Group Dockerfile and docker-compose dependency updates in single PR."
      ]
    },
    {
      "groupName": "Helm",
      "groupSlug": "helm",
      "matchManagers": [
        "helmv3"
      ],
      "description": [
        "Group Helm chart dependency updates in single PR."
      ]
    },
    {
      "groupName": "Frontend",
      "groupSlug": "frontend",
      "matchManagers": [
        "npm"
      ],
      "description": [
        "Group frontend (npm) dependency updates in single PR."
      ]
    },
    {
      "groupName": "Toolchain",
      "groupSlug": "toolchain",
      "matchManagers": [
        "custom.regex"
      ],
      "description": [
        "Group updates to the pinned tool versions in scripts/lib/versions.sh in a single PR."
      ]
    },
    {
      "groupName": "Python",
      "groupSlug": "python",
      "matchManagers": [
        "pep621"
      ],
      "description": [
        "Group Python (uv/pep621) dependency updates in single PR."
      ]
    },
    {
      "matchJsonata": [
        "$exists(vulnerabilityFixVersion) or isVulnerabilityAlert = true"
      ],
      "enabled": true,
      "description": [
        "Always allow vulnerability/security fixes, even when other rules disable specific dependencies."
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 10,
  "printConfig": true,
  "rebaseWhen": "behind-base-branch",
  "reviewersFromCodeOwners": true,
  "semanticCommits": "enabled",
  "timezone": "Etc/UTC",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  }
}
